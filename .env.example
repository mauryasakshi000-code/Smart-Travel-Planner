# Copy this file to .env and replace every "change_me" value.
# .env is git-ignored; never commit real credentials.
# Avoid "$" in values: Docker Compose treats it as variable interpolation.

# ---------- PostgreSQL (Docker) ----------
POSTGRES_USER=travel_admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=smart_travel_planner
# Host port mapped to PostgreSQL's port 5432 inside the container
POSTGRES_HOST_PORT=5432
# Load database/seeds (sample users, trips, blogs...) after migrations.
# Development only: set to false for a real deployment.
RUN_SEEDS=true

# ---------- pgAdmin (Docker) ----------
PGADMIN_DEFAULT_EMAIL=admin@smarttravel.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_HOST_PORT=5050

# ---------- C++ backend ----------
BACKEND_HOST_PORT=8080
SERVER_THREADS=4
DB_POOL_SIZE=8
# Browser origin allowed to call the backend directly (CORS)
CORS_ORIGIN=http://localhost:5173

# ---------- React frontend ----------
# Keep at 5173 unless you also change the Vite HMR port
FRONTEND_HOST_PORT=5173
